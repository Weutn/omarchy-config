{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
// Example: replace the default About action by reusing the same id. Existing
// fields are kept unless overridden.
// "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

// Médias stockés sur la forge (Vault/Medias) — browsing + lecture mpv via SSH.
// Sous « apps » pour apparaître avec les autres applications (id racine "apps").
"apps.medias": {"icon":"","label":"Vault Media","description":"Films, séries et musique de la forge (Vault/Medias)","action":"omarchy-launch-or-focus-tui forge-media"},

// Jeux : launcher GOG (Heroic), Steam et raccourci direct Civ IV BTS.
"games": {"icon":"","label":"Games","description":"Steam, GOG (Heroic) et jeux installés"},
"games.heroic": {"icon":"󰀄","label":"GOG / Heroic","description":"Client GOG (gogdl, jeux natifs Linux + Wine)","action":"uwsm-app -- heroic"},
"games.steam": {"icon":"","label":"Steam","description":"Client Steam","action":"uwsm-app -- steam"},
"games.civ4": {"icon":"","label":"Civ IV: Beyond the Sword","description":"Lancer directement Civ IV BTS (Steam)","action":"uwsm-app -- steam \"steam://rungameid/8800\""},
"games.openrct2": {"icon":"󰢫","label":"OpenRCT2","description":"RollerCoaster Tycoon 2 (moteur natif, données Steam RCT2 TT)","action":"uwsm-app -- openrct2"},
"games.vcmi": {"icon":"󰢫","label":"VCMI — Heroes of Might and Magic III","description":"HoMM3 natif (données GOG)","action":"uwsm-app -- /home/weutn/Applications/VCMI.AppImage"},
"games.homm3": {"icon":"󰢫","label":"HoMM3 Complete (Wine)","description":"Shadow of Death + Armageddon's Blade, via Wine","action":"uwsm-app -- gtk-launch homm3"},
"games.homm3_hota": {"icon":"󰢫","label":"HoMM3: Horn of the Abyss (Wine)","description":"HotA 1.8.1 + HD mod, via Wine","action":"uwsm-app -- gtk-launch homm3_hota"},
"games.fallout1": {"icon":"󰢫","label":"Fallout 1 (Wine)","description":"Fallout 1997 (GOG)","action":"uwsm-app -- gtk-launch fallout1"},
"games.fallout2": {"icon":"󰢫","label":"Fallout 2 (Wine)","description":"Fallout 2 1998 (GOG)","action":"uwsm-app -- gtk-launch fallout2"},
"games.rct_deluxe": {"icon":"󰢫","label":"RCT Deluxe (Wine)","description":"RollerCoaster Tycoon 1 (GOG)","action":"uwsm-app -- gtk-launch rct_deluxe"}
}
